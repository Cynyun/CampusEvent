          <mxGeometry height="120" width="370" x="20" y="940" as="geometry" />
        </mxCell>
        <mxCell id="cr02-seq3" parent="1" style="text;align=left;verticalAlign=top;fontSize=8;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;CR-02 变更&lt;/b&gt; &lt;font color=&quot;#38761d&quot;&gt;[NEW]&lt;/font&gt;&lt;br&gt;① 事件：SUBMITTED + 状态 APPROVED&lt;br&gt;② 新增 EmailNotificationObserver，订阅同一事件&lt;br&gt;③ 直接报名发“报名成功”邮件&lt;br&gt;④ 邮件失败写 EmailLog(FAILED)，不影响报名事务&lt;br&gt;⑤ 同一业务事件只发一次" vertex="1">
          <mxGeometry height="120" width="380" x="400" y="940" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
