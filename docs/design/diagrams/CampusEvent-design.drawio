        <mxCell id="cr-title" parent="1" style="text;align=left;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;" value="&lt;b&gt;CR-01 / CR-02 变更区&lt;/b&gt;　&lt;font color=&quot;#38761d&quot;&gt;绿色 = 新增&lt;/font&gt;　&lt;font color=&quot;#b45f06&quot;&gt;黄色 = 修改&lt;/font&gt;" vertex="1">
          <mxGeometry height="28" width="740" x="30" y="598" as="geometry" />
        </mxCell>
        <mxCell id="cr-context" parent="1" style="rounded=0;fontSize=9;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;RegistrationContext&lt;/b&gt; &lt;font color=&quot;#38761d&quot;&gt;[NEW]&lt;/font&gt;&lt;br&gt;────&lt;br&gt;+ student: Student&lt;br&gt;+ activity: Activity&lt;br&gt;+ approvedCount: int&lt;br&gt;────&lt;br&gt;«record»" vertex="1">
          <mxGeometry height="95" width="170" x="40" y="640" as="geometry" />
        </mxCell>
        <mxCell id="cr-grade-policy" parent="1" style="rounded=0;fontSize=9;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;GradeLimitedDirectRegistrationPolicy&lt;/b&gt; &lt;font color=&quot;#38761d&quot;&gt;[NEW]&lt;/font&gt;&lt;br&gt;────&lt;br&gt;+ decide(ctx): Status&lt;br&gt;────&lt;br&gt;1) grade ∈ {2,3}&lt;br&gt;2) 容量检查&lt;br&gt;3) APPROVED / 403 / 409" vertex="1">
          <mxGeometry height="100" width="210" x="230" y="640" as="geometry" />
        </mxCell>
        <mxCell id="cr-email-observer" parent="1" style="rounded=0;fontSize=9;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;EmailNotificationObserver&lt;/b&gt; &lt;font color=&quot;#38761d&quot;&gt;[NEW]&lt;/font&gt;&lt;br&gt;────&lt;br&gt;+ onEvent(event): void&lt;br&gt;────&lt;br&gt;SUBMITTED+APPROVED&lt;br&gt;APPROVED / REJECTED" vertex="1">
          <mxGeometry height="95" width="170" x="460" y="640" as="geometry" />
        </mxCell>
        <mxCell id="cr-email-sender" parent="1" style="rounded=0;fontSize=9;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;EmailSender&lt;/b&gt; &lt;font color=&quot;#38761d&quot;&gt;[NEW]&lt;/font&gt;&lt;br&gt;────&lt;br&gt;«interface»&lt;br&gt;+ send(msg): void" vertex="1">
          <mxGeometry height="80" width="110" x="650" y="640" as="geometry" />
        </mxCell>
        <mxCell id="cr-mock-sender" parent="1" style="rounded=0;fontSize=9;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;MockEmailSender&lt;/b&gt; &lt;font color=&quot;#38761d&quot;&gt;[NEW]&lt;/font&gt;&lt;br&gt;────&lt;br&gt;+ send(msg): void&lt;br&gt;────&lt;br&gt;写 EmailLog&lt;br&gt;可模拟失败" vertex="1">
          <mxGeometry height="90" width="170" x="40" y="755" as="geometry" />
        </mxCell>
        <mxCell id="cr-email-log" parent="1" style="rounded=0;fontSize=9;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;EmailLog&lt;/b&gt; &lt;font color=&quot;#38761d&quot;&gt;[NEW]&lt;/font&gt;&lt;br&gt;────&lt;br&gt;- registrationId&lt;br&gt;- recipient / subject&lt;br&gt;- status / error&lt;br&gt;- createdAt" vertex="1">
          <mxGeometry height="90" width="160" x="230" y="755" as="geometry" />
        </mxCell>
        <mxCell id="cr-email-log-mapper" parent="1" style="rounded=0;fontSize=9;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;EmailLogMapper&lt;/b&gt; &lt;font color=&quot;#38761d&quot;&gt;[NEW]&lt;/font&gt;&lt;br&gt;────&lt;br&gt;«mapper»&lt;br&gt;+ insert(log): void" vertex="1">
          <mxGeometry height="80" width="150" x="410" y="755" as="geometry" />
        </mxCell>
        <mxCell id="cr-email-message" parent="1" style="rounded=0;fontSize=9;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;EmailMessage&lt;/b&gt; &lt;font color=&quot;#38761d&quot;&gt;[NEW]&lt;/font&gt;&lt;br&gt;────&lt;br&gt;- registrationId&lt;br&gt;- eventType&lt;br&gt;- recipient&lt;br&gt;- subject / content" vertex="1">
          <mxGeometry height="95" width="170" x="580" y="755" as="geometry" />
        </mxCell>
        <mxCell id="cr-schema-migration" parent="1" style="rounded=0;fontSize=9;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;SchemaMigration&lt;/b&gt; &lt;font color=&quot;#38761d&quot;&gt;[NEW]&lt;/font&gt;&lt;br&gt;────&lt;br&gt;启动时检查列&lt;br&gt;ALTER student ADD grade&lt;br&gt;（基础设施）" vertex="1">
          <mxGeometry height="80" width="200" x="40" y="865" as="geometry" />
        </mxCell>
        <mxCell id="cr-relations" parent="1" style="text;align=left;verticalAlign=top;fontSize=8;fillColor=#fafafa;strokeColor=#cccccc;whiteSpace=wrap;html=1;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;新增/修改关系&lt;/b&gt;&lt;br&gt;RegistrationService → RegistrationContext（构造）&lt;br&gt;RegistrationPolicy ← GradeLimitedDirectRegistrationPolicy&lt;br&gt;RegistrationPolicyFactory → GradeLimitedDirectRegistrationPolicy&lt;br&gt;NotificationObserver ← EmailNotificationObserver → EmailSender&lt;br&gt;EmailSender ← MockEmailSender → EmailLog ← EmailLogMapper&lt;br&gt;Student.grade ← SchemaMigration（老库补列）" vertex="1">
          <mxGeometry height="120" width="490" x="260" y="865" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
